PORT=3333
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Chave secreta para assinatura dos tokens JWT
JWT_SECRET=super_secret_jwt_key_troque_em_producao_123456
JWT_EXPIRES_IN=7d

# Configuração do Banco de Dados (SQLite padrão local para zero burocracia de setup)
# Para PostgreSQL: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="file:./dev.db"

# Dados padrão do Usuário Mestre para inicialização (Seed)
MASTER_ADMIN_NAME="Administrador Geral"
MASTER_ADMIN_EMAIL="admin@contabilidade.com"
MASTER_ADMIN_PASSWORD="admin_master_123"

# Google OAuth Client ID (Opcional para modo em produção / O Google funciona mesmo sem chave em modo demonstração)
GOOGLE_CLIENT_ID=""
